data = resp,
aes(RDA1, RDA2, label = label),
size = 3.5,
max.overlaps = Inf,
box.padding = 0.5,
force = 2
) +
theme_classic(base_size = 14) +
coord_fixed()
# RDA
rda_full <- rda(
y ~ clade + SLA + leaf_N_area + SD_sbs_mean + LDMC + P50 +
gs_max + H_m + VPD50 + VPD_opt + f_shallow +
mean_daily_max + mean_daily_q95,
data = clean_data
)
# Extract scores
sites <- as.data.frame(scores(rda_full, display = "sites", scaling = 2))
env   <- as.data.frame(scores(rda_full, display = "bp", scaling = 2))
resp  <- as.data.frame(scores(rda_full, display = "species", scaling = 2))
sites$label <- rownames(sites)
env$label   <- rownames(env)
resp$label  <- rownames(resp)
# Plot
ggplot() +
# Samples
geom_point(
data = sites,
aes(RDA1, RDA2),
size = 2.5
) +
# Environmental arrows
geom_segment(
data = env,
aes(x = 0, y = 0, xend = RDA1, yend = RDA2),
arrow = arrow(length = unit(0.2, "cm")),
linewidth = 0.6
) +
# Environmental labels
geom_text_repel(
data = env,
aes(RDA1, RDA2, label = label),
size = 4,
max.overlaps = Inf,
box.padding = 0.5,
force = 2
) +
# y-variable arrows
geom_segment(
data = resp,
aes(x = 0, y = 0, xend = RDA1, yend = RDA2),
arrow = arrow(length = unit(0.15, "cm")),
linewidth = 0.4
) +
# y-variable labels
geom_text_repel(
data = resp,
aes(RDA1, RDA2, label = label),
size = 3.5,
max.overlaps = Inf,
box.padding = 0.5,
force = 2
) +
theme_classic(base_size = 14) +
coord_fixed()
# RDA
rda_full <- rda(
y ~ clade + SLA + leaf_N_area + SD_sbs_mean + LDMC + P50 +
gs_max + H_m + VPD50 + VPD_opt + f_shallow +
mean_daily_max + mean_daily_q95,
data = clean_data
)
# Extract scores
sites <- as.data.frame(scores(rda_full, display = "sites", scaling = 2))
env   <- as.data.frame(scores(rda_full, display = "bp", scaling = 2))
resp  <- as.data.frame(scores(rda_full, display = "species", scaling = 2))
# Labels
sites$label <- rownames(sites)
env$label   <- rownames(env)
resp$label  <- rownames(resp)
# Identify variable type
env$type  <- "X variables"
resp$type <- "Y variables"
# Combine variables
vars <- rbind(
env[, c("RDA1", "RDA2", "label", "type")],
resp[, c("RDA1", "RDA2", "label", "type")]
)
ggplot() +
# Samples
geom_point(
data = sites,
aes(RDA1, RDA2),
size = 2.5,
colour = "grey40"
) +
# Arrows for BOTH X and Y variables
geom_segment(
data = vars,
aes(
x = 0, y = 0,
xend = RDA1,
yend = RDA2,
colour = type
),
arrow = arrow(length = unit(0.18, "cm")),
linewidth = 0.6
) +
# Labels for BOTH
geom_text_repel(
data = vars,
aes(
RDA1, RDA2,
label = label,
colour = type
),
size = 4,
max.overlaps = Inf,
box.padding = 0.6,
point.padding = 0.3,
force = 3
) +
# Colours
scale_colour_manual(
values = c(
"X variables" = "#0072B2",
"Y variables" = "#D55E00"
)
) +
theme_classic(base_size = 15) +
coord_fixed() +
labs(
x = paste0(
"RDA1 (",
round(summary(rda_full)$cont$importance[2, 1] * 100, 1),
"%)"
),
y = paste0(
"RDA2 (",
round(summary(rda_full)$cont$importance[2, 2] * 100, 1),
"%)"
),
colour = NULL
)
