rda_model2<-rda(y~TSQ_TREE_DIVERSITY+OPENNESS+DIVERSITY_LEVEL+NEIGH_SHRUB_DIVERSITY+Stem_Increments_PC1+TSQ_TOTAL_BA+RaoQ+summer_mean_mean, data = model_data_complete)
summary(rda_model2)
#plot RDA
# Plot empty canvas
plot(rda_model2, type = "n", scaling = 2)
# Add sites (samples)
points(rda_model2, display = "sites", pch = 16, col = "grey")
# Response arrows
sp <- scores(rda_model2, display = "species", scaling = 2)
arrows(0, 0, sp[,1], sp[,2], length = 0.08, col = "blue", lwd = 2)
text(sp[,1], sp[,2], labels = rownames(sp), col = "blue", pos = 4)
# Add explanatory variables (arrows)
bp <- scores(rda_model2, display = "bp", scaling = 2)
