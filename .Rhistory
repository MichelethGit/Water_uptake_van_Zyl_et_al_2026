# Spearman correlations
result <- corr.test(
model_data_corr,
method = "spearman",
use = "pairwise",
adjust = "none"
)
cor_matrix <- result$r
p_matrix   <- result$p
new_names <- c(
summer_mean_mean = "Summer soil moisture",
RaosQ = "Functional diversity (Rao's Q)",
TSQ_TOTAL_BA = "Competition (TSQ total BA)",
TSQ_TREE_DIVERSITY = "TSQ Tree diversity",
OPENNESS = "Light availability (openness)",
Stem_Increments_PC1 = "Stem increment (Growth)",
DIVERSITY_LEVEL = "Plot level Diversity",
NEIGH_SHRUB_DIVERSITY = "Neighbour shrub diversity",
d13C = "δ¹³C",
d18O = "δ¹⁸O "
)
rownames(cor_matrix) <- dplyr::recode(rownames(cor_matrix), !!!new_names)
colnames(cor_matrix) <- dplyr::recode(colnames(cor_matrix), !!!new_names)
rownames(p_matrix) <- rownames(cor_matrix)
colnames(p_matrix) <- colnames(cor_matrix)
df_cor <- melt(cor_matrix)
df_p   <- melt(p_matrix)
df <- cbind(df_cor, p = df_p$value)
colnames(df) <- c("Var1", "Var2", "r", "p")
df$stars <- ifelse(df$p < 0.001, "***",
ifelse(df$p < 0.01, "**",
ifelse(df$p < 0.05, "*", "")))
df$Var1 <- factor(df$Var1, levels = colnames(cor_matrix))
df$Var2 <- factor(df$Var2, levels = colnames(cor_matrix))
# Keep only the upper triangle
df <- df[as.numeric(df$Var1) < as.numeric(df$Var2), ]
ggplot(df, aes(x = Var1, y = Var2, fill = r)) +
geom_tile() +
geom_text(aes(label = sprintf("%.2f", r)), size = 5) +
geom_text(aes(label = stars), color = "black", vjust = -0.8, size = 6) +
scale_fill_gradient2(
low = "#B2182B",
mid = "white",
high = "#2166AC",
midpoint = 0
) +
theme_classic(base_size = 16) +
theme(
axis.title = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1, size = 14),
axis.text.y = element_text(size = 14),
panel.grid = element_blank()
)
